{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "VITE_API_URL", 
        "VITE_VENDOR_URL", 
        "VITE_ADMIN_URL", 
        "VITE_USER_PORT",
        "VITE_VENDOR_PORT",
        "VITE_ADMIN_PORT",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "NODE_ENV",
        "DATABASE_URL",
        "JWT_SECRET",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "ADMIN_PHONE_NUMBER"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
