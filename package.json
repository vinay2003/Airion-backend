{
  "name": "airion",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:user": "turbo build --filter=@airion/user-website",
    "build:vendor": "turbo build --filter=@airion/vendor-dashboard",
    "build:admin": "turbo build --filter=@airion/admin-panel",
    "build:api": "turbo build --filter=@airion/api",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "^3.0.0",
    "concurrently": "^8.2.0"
  }
}
