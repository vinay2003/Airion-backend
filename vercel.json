{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://airion-backend-1.onrender.com/api/:path*" },
    { "source": "/vendor(/.*)?", "destination": "/vendor/index.html" },
    { "source": "/admin(/.*)?", "destination": "/admin/index.html" },
    { "source": "/((?!vendor|admin|api|assets|favicon.ico|logo.svg).*)", "destination": "/index.html" }
  ]
}