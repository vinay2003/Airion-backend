{
  "name": "ease2event",
  "private": true,
  "description": "Premium Event Planning Platform (Vercel Optimized)",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && mkdir -p dist/vendor dist/admin && cp -r apps/user-website/dist/* dist/ && cp -r apps/vendor-dashboard/dist/* dist/vendor/ && cp -r apps/admin-panel/dist/* dist/admin/",
    "build:user": "turbo build --filter=@ease2event/user-website",
    "build:vendor": "turbo build --filter=@ease2event/vendor-dashboard",
    "build:admin": "turbo build --filter=@ease2event/admin-panel",
    "build:api": "turbo build --filter=@ease2event/api",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "turbo": "latest"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "concurrently": "^8.2.0",
    "vite": "^7.2.4",
    "typescript": "~5.9.3",
    "eslint": "^9.39.1"
  }
}
