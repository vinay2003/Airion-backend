{
  "name": "ease2event",
  "private": true,
  "description": "Premium Event Planning Platform (Vercel Optimized)",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run kill-dev && turbo dev",
    "kill-dev": "npx -y kill-port 5173 5174 5175 3000 || true",
    "build": "turbo build --force && rm -rf dist && mkdir -p dist/vendor dist/admin && cp -r apps/user-website/dist/* dist/ && cp -r apps/vendor-dashboard/dist/* dist/vendor/ && cp -r apps/admin-panel/dist/* dist/admin/",
    "build:user": "turbo build --filter=@ease2event/user-website",
    "build:vendor": "turbo build --filter=@ease2event/vendor-dashboard",
    "build:admin": "turbo build --filter=@ease2event/admin-panel",
    "build:api": "turbo run build --filter=@ease2event/api --force",
    "start:api": "cd apps/api && npm run start",
    "start:api:prod": "cd apps/api && npm run start:prod",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "turbo": "latest",
    "vite": "^7.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "vite-plugin-pwa": "^1.2.0",
    "@tailwindcss/vite": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "typescript": "~5.9.3",
    "concurrently": "^8.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "eslint": "^9.39.1"
  }
}
